{
  "name": "AI/ML Internship",
  "build": {"dockerfile": "Dockerfile", "context": ".."},
  "remoteUser": "vscode",
  "forwardPorts": [8888],
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-toolsai.jupyter"],
      "settings": {"python.testing.pytestEnabled": true, "python.testing.pytestArgs": ["tests"]}
    }
  }
}
